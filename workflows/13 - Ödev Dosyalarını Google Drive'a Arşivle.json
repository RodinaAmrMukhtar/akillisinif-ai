    {
      "parameters": {
        "jsCode": "const preparedItems = $items(\"Prepare Drive Files\");\nconst uploadItems = $items(\"Google Drive Upload File\");\n\nconst grouped = new Map();\n\nfunction getString(value) {\n  return String(value || \"\").trim();\n}\n\nfor (let index = 0; index < uploadItems.length; index += 1) {\n  const source = preparedItems[index]?.json || {};\n  const uploaded = uploadItems[index]?.json || {};\n\n  const fileId =\n    uploaded.id ||\n    uploaded.fileId ||\n    \"\";\n\n  const fileName =\n    uploaded.name ||\n    source.archiveFileName ||\n    \"Google Drive dosyası\";\n\n  const fileLink =\n    uploaded.webViewLink ||\n    uploaded.webContentLink ||\n    (fileId ? `https://drive.google.com/file/d/${fileId}/view` : \"\");\n\n  if (!source.submissionId || !fileLink) continue;\n\n  if (!grouped.has(source.submissionId)) {\n    grouped.set(source.submissionId, {\n      links: [],\n      folderLink: source.driveFolderLink,\n    });\n  }\n\n  grouped.get(source.submissionId).links.push(`${fileName}: ${fileLink}`);\n}\n\nconst today = new Date().toISOString().slice(0, 10);\nconst output = [];\n\nfor (const [submissionId, value] of grouped.entries()) {\n  output.push({\n    json: {\n      submissionId,\n      fields: {\n        Drive_Arsivlendi_Mi: true,\n        Drive_Dosya_Linkleri: value.links.join(\"\\n\"),\n        Drive_Klasor_Linki: value.folderLink,\n        Drive_Arsiv_Tarihi: today,\n      },\n    },\n  });\n}\n\nreturn output;"
      },
