      "parameters": {
        "jsCode": "function normalizeRecord(json) {\n  if (!json) return null;\n\n  if (Array.isArray(json.records)) {\n    return json.records.map(normalizeRecord).filter(Boolean);\n  }\n\n  if (json.fields) {\n    return {\n      id: json.id || json.recordId,\n      fields: json.fields,\n    };\n  }\n\n  const { id, recordId, createdTime, ...rest } = json;\n\n  return {\n    id: id || recordId,\n    fields: rest,\n  };\n}\n\nfunction getRecords(nodeName) {\n  const items = $items(nodeName) || [];\n  const records = [];\n\n  for (const item of items) {\n    const normalized = normalizeRecord(item.json);\n\n    if (Array.isArray(normalized)) {\n      records.push(...normalized);\n    } else if (normalized) {\n      records.push(normalized);\n    }\n  }\n\n  return records.filter((record) => record.id);\n}\n\nfunction asLinks(value) {\n  if (!value) return [];\n\n  if (Array.isArray(value)) {\n    return value\n      .map((item) => {\n        if (typeof item === \"string\") return item;\n        if (item?.id) return item.id;\n        if (item?.recordId) return item.recordId;\n        return String(item || \"\");\n      })\n      .map((item) => item.trim())\n      .filter(Boolean);\n  }\n\n  if (typeof value === \"string\") {\n    return [value.trim()].filter(Boolean);\n  }\n\n  return [];\n}\n\nfunction getString(value) {\n  return String(value || \"\").trim();\n}\n\nfunction cleanFileName(value) {\n  return getString(value)\n    .replace(/[\\\\/:*?\"<>|#%{}~&]/g, \"-\")\n    .replace(/\\s+/g, \" \")\n    .trim()\n    .slice(0, 160);\n}\n\nfunction getAttachments(value) {\n  if (!Array.isArray(value)) return [];\n\n  return value\n    .map((file) => ({\n      id: getString(file.id),\n      filename: getString(file.filename) || \"dosya\",\n      url: getString(file.url),\n      type: getString(file.type),\n    }))\n    .filter((file) => file.url);\n}\n\nconst driveFolderId = \"1im1mBumYAiX5lOsQ19u98pm6mxhH6oQt\";\n\nconst submissions = getRecords(\"GET Submissions To Archive\");\nconst users = getRecords(\"GET Users\");\nconst assignments = getRecords(\"GET Assignments\");\nconst classes = getRecords(\"GET Classes\");\n\nconst output = [];\n\nfor (const submission of submissions) {\n  const studentId = asLinks(submission.fields.Ogrenci)[0];\n  const assignmentId = asLinks(submission.fields.Odev)[0];\n  const classId = asLinks(submission.fields.Sinif)[0];\n\n  const student = users.find((user) => user.id === studentId);\n  const assignment = assignments.find((item) => item.id === assignmentId);\n  const classRecord = classes.find((item) => item.id === classId);\n\n  const studentName =\n    getString(student?.fields?.Ad_Soyad) ||\n    getString(student?.fields?.Eposta) ||\n    \"Ogrenci\";\n\n  const assignmentTitle =\n    getString(assignment?.fields?.Odev_Basligi) ||\n    \"Odev\";\n\n  const className =\n    getString(classRecord?.fields?.Sinif_Adi) ||\n    getString(classRecord?.fields?.Ders_Adi) ||\n    \"Sinif\";\n\n  const attachments = getAttachments(submission.fields.Dosya);\n\n  for (let index = 0; index < attachments.length; index += 1) {\n    const attachment = attachments[index];\n    const originalName = cleanFileName(attachment.filename);\n\n    const archiveName = cleanFileName(\n      `${className}__${assignmentTitle}__${studentName}__${submission.id}__${index + 1}__${originalName}`,\n    );\n\n    output.push({\n      json: {\n        submissionId: submission.id,\n        driveFolderId,\n        driveFolderLink: `https://drive.google.com/drive/folders/${driveFolderId}`,\n        downloadUrl: attachment.url,\n        originalFileName: originalName,\n        archiveFileName: archiveName,\n        studentName,\n        assignmentTitle,\n        className,\n      },\n    });\n  }\n}\n\nreturn output;"
      },
