    {
      "parameters": {
        "jsCode": "function normalizeRecord(json) {\n  if (!json) return null;\n\n  if (Array.isArray(json.records)) {\n    return json.records.map(normalizeRecord).filter(Boolean);\n  }\n\n  if (json.fields) {\n    return {\n      id: json.id || json.recordId,\n      fields: json.fields,\n    };\n  }\n\n  const { id, recordId, createdTime, ...rest } = json;\n\n  return {\n    id: id || recordId,\n    fields: rest,\n  };\n}\n\nfunction getRecords(nodeName) {\n  const items = $items(nodeName) || [];\n  const records = [];\n\n  for (const item of items) {\n    const normalized = normalizeRecord(item.json);\n\n    if (Array.isArray(normalized)) {\n      records.push(...normalized);\n    } else if (normalized) {\n      records.push(normalized);\n    }\n  }\n\n  return records.filter((record) => record.id);\n}\n\nfunction asLinks(value) {\n  if (!value) return [];\n\n  if (Array.isArray(value)) {\n    return value\n      .map((item) => {\n        if (typeof item === \"string\") return item;\n        if (item?.id) return item.id;\n        if (item?.recordId) return item.recordId;\n        return String(item || \"\");\n      })\n      .map((item) => item.trim())\n      .filter(Boolean);\n  }\n\n  if (typeof value === \"string\") {\n    return [value.trim()].filter(Boolean);\n  }\n\n  return [];\n}\n\nfunction getString(value) {\n  return String(value || \"\").trim();\n}\n\nfunction buildEmailHtml({\n  teacherName,\n  studentName,\n  className,\n  trackingCode,\n}) {\n  return `\n<div style=\"font-family:Arial,Helvetica,sans-serif;background:#f1f5f9;padding:32px;\">\n  <div style=\"max-width:640px;margin:auto;background:white;border-radius:24px;overflow:hidden;border:1px solid #e2e8f0;\">\n    <div style=\"background:#0f172a;color:white;padding:28px 32px;\">\n      <div style=\"font-size:12px;letter-spacing:4px;text-transform:uppercase;color:#bfdbfe;font-weight:700;\">\n        AkıllıSınıf AI\n      </div>\n      <h1 style=\"margin:12px 0 0;font-size:28px;line-height:1.2;color:#ffffff;\">\n        Yeni Katılım İsteği\n      </h1>\n      <p style=\"margin:12px 0 0;color:#dbeafe;font-size:15px;line-height:1.6;\">\n        Bu bildirim n8n otomasyonu tarafından otomatik oluşturulmuştur.\n      </p>\n    </div>\n\n    <div style=\"padding:32px;color:#0f172a;\">\n      <p style=\"margin:0 0 16px;font-size:16px;line-height:1.7;\">\n        Merhaba <strong>${teacherName}</strong>,\n      </p>\n\n      <p style=\"margin:0 0 20px;font-size:16px;line-height:1.7;\">\n        <strong>${studentName}</strong> adlı öğrenci,\n        <strong>${className}</strong> sınıfına katılmak için onay bekliyor.\n      </p>\n\n      <div style=\"margin:22px 0;padding:18px;border-radius:18px;background:#eff6ff;border:1px solid #bfdbfe;\">\n        <p style=\"margin:0;color:#1d4ed8;font-size:12px;text-transform:uppercase;font-weight:700;letter-spacing:1px;\">\n          Bekleyen İşlem\n        </p>\n        <p style=\"margin:8px 0 0;font-size:20px;font-weight:700;color:#1e3a8a;\">\n          Katılım isteğini öğretmen panelinden onaylayabilir veya reddedebilirsiniz.\n        </p>\n      </div>\n\n      <p style=\"margin:22px 0;font-size:15px;line-height:1.7;color:#475569;\">\n        Lütfen AkıllıSınıf AI öğretmen panelindeki Katılım İstekleri sayfasından bu isteği kontrol edin.\n      </p>\n\n      <div style=\"margin-top:28px;padding:16px;border-radius:16px;background:#f8fafc;border:1px solid #e2e8f0;color:#64748b;font-size:12px;line-height:1.6;\">\n        Sistem takip kodu: ${trackingCode}\n      </div>\n    </div>\n\n    <div style=\"background:#f8fafc;padding:20px 32px;border-top:1px solid #e2e8f0;color:#64748b;font-size:12px;line-height:1.6;\">\n      AkıllıSınıf AI · Yapay Zekâ Destekli Sınıf Performans ve Erken Uyarı Sistemi\n    </div>\n  </div>\n</div>\n`;\n}\n\nconst users = getRecords(\"GET Users\");\nconst classes = getRecords(\"GET Classes\");\nconst pendingMemberships = getRecords(\"GET Pending Memberships\");\nconst existingNotifications = getRecords(\"GET Existing Join Notifications\");\n\nconst output = [];\n\nfor (const membership of pendingMemberships) {\n  const membershipId = membership.id;\n  const studentId = asLinks(membership.fields.Kullanici)[0];\n  const classId = asLinks(membership.fields.Sinif)[0];\n\n  if (!studentId || !classId) continue;\n\n  const student = users.find((user) => user.id === studentId);\n  const classRecord = classes.find((item) => item.id === classId);\n\n  if (!student || !classRecord) continue;\n\n  const teacherId = asLinks(classRecord.fields.Ogretmen)[0];\n\n  if (!teacherId) continue;\n\n  const teacher = users.find((user) => user.id === teacherId);\n\n  if (!teacher) continue;\n\n  const teacherEmail = getString(teacher.fields.Eposta);\n  const teacherName = getString(teacher.fields.Ad_Soyad) || \"Öğretmen\";\n  const studentName = getString(student.fields.Ad_Soyad) || \"Öğrenci\";\n  const className =\n    getString(classRecord.fields.Sinif_Adi) ||\n    getString(classRecord.fields.Ders_Adi) ||\n    \"Sınıf\";\n\n  if (!teacherEmail) continue;\n\n  const trackingCode = `KATILIM:${membershipId}:OGRETMEN:${teacherId}`;\n\n  const duplicateExists = existingNotifications.some((notification) => {\n    const message = getString(notification.fields.Mesaj);\n    return message.includes(trackingCode);\n  });\n\n  if (duplicateExists) continue;\n\n  const message =\n    `Merhaba ${teacherName}, ${studentName} adlı öğrenci \"${className}\" sınıfına katılmak için onay bekliyor. ` +\n    `Lütfen öğretmen panelindeki Katılım İstekleri sayfasından bu isteği kontrol edin.\\n\\n` +\n    `Sistem takip kodu: ${trackingCode}`;\n\n  const emailSubject = `Yeni katılım isteği: ${studentName}`;\n\n  const emailHtml = buildEmailHtml({\n    teacherName,\n    studentName,\n    className,\n    trackingCode,\n  });\n\n  output.push({\n    json: {\n      emailTo: teacherEmail,\n      emailSubject,\n      emailHtml,\n      teacherName,\n      studentName,\n      className,\n      trackingCode,\n      fields: {\n        Bildirim_Basligi: \"Katılım isteği bekliyor\",\n        Alici: [teacherId],\n        Sinif: [classId],\n        Bildirim_Turu: \"Katılım İsteği\",\n        Mesaj: message,\n        Onem_Derecesi: \"Orta\",\n        Okundu_Mu: false,\n        Gonderildi_Mi: true,\n        Kanal: \"E-posta + Webhook\",\n      },\n    },\n  });\n}\n\nreturn output;"
      },
